# Copy to apps/chatgpt-cleaner/.env for local development. Never commit real values.

# Publishable Supabase URL for the dedicated project (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Publishable anon key only. Never put a service-role key here.
VITE_SUPABASE_ANON_KEY=

# Optional explicit redirect URL for chrome.identity / extension callback page
VITE_SUPABASE_AUTH_REDIRECT_URL=
