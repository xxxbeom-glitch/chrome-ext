# Copy to apps/chatgpt-cleaner/.env for local development. Never commit real values.
# Canonical naming for this WXT app (do not use VITE_SUPABASE_*).

# Publishable Supabase URL for the dedicated project (https://<project-ref>.supabase.co)
WXT_PUBLIC_SUPABASE_URL=

# Publishable anon/publishable key only. Never put a service-role key here.
WXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional override for chrome.identity redirect. Prefer leaving empty so the
# extension uses browser.identity.getRedirectURL() after first load.
# Example after first unpacked load: https://<extension-id>.chromiumapp.org/
WXT_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=
